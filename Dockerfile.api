# ایمیج backend — FastAPI + هسته‌ی تحلیل mktcore + خروجی PDF (WeasyPrint)
FROM python:3.11-slim

# وابستگی‌های سیستمی WeasyPrint (pango/cairo) + فونت fallback برای PDF آفلاین
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz0b \
        libgdk-pixbuf-2.0-0 libcairo2 shared-mime-info \
        fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
COPY api ./api
RUN pip install --no-cache-dir ".[api,pdf]"

# داده‌های ماندگار (SQLite + نشست‌ها) — با volume نگه دارید
ENV MKT_DATA_DIR=/data
VOLUME ["/data"]

EXPOSE 8000

# تک-worker الزامی است: لایه‌ی ماندگاری و زمان‌بند برای تک-پروسه طراحی شده‌اند
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
