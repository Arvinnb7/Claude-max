# کلید API انتروپیک — برای لایه‌ی استراتژی هوش مصنوعی لازم است
ANTHROPIC_API_KEY=sk-ant-...

# مدل مورد استفاده برای روایت و استراتژی مارکتر سنیور (پیش‌فرض)
MKT_MODEL=claude-opus-4-8

# مدل ارزان‌تر برای پیش‌نویس سریع (اختیاری)
MKT_DRAFT_MODEL=claude-haiku-4-5

# سطح تلاش استدلال: low | medium | high | max
MKT_EFFORT=high

# واحد پول برای نمایش گزارش‌ها
MKT_CURRENCY=تومان

# اجرای تست‌های واقعی هوش مصنوعی (فقط محلی) — 1 برای فعال‌سازی
MKT_LIVE_AI=0

# ---------------------------------------------------------- پایداری و سرور
# پوشه‌ی داده‌های ماندگار (SQLite نشست‌ها/jobها/outbox + فایل‌های نشست)
MKT_DATA_DIR=data
# سیاست نگه‌داری — در همه‌ی کلیدهای زیر ۰ به‌معنی «هرگز» است.
# نتیجه‌ی تحلیل (داشبورد) هرگز خودکار حذف نمی‌شود؛ فقط فایل‌های سنگین هرس می‌شوند.
MKT_RETENTION_RAW_DAYS=30      # حذف فایل خام (فقط برای «تحلیل مجدد» لازم است)
MKT_RETENTION_HEAVY_DAYS=180   # بایگانی فایل‌های تحلیل (داشبورد باقی می‌ماند)
MKT_RETENTION_DELETE_DAYS=0    # حذف کامل نشست — پیش‌فرض: هرگز
MKT_RETENTION_JOBS_DAYS=14     # پاک‌سازی رکورد jobهای تمام‌شده
# منسوخ: MKT_SESSION_TTL_HOURS دیگر نشست‌ها را حذف نمی‌کند
# سقف حجم فایل آپلودی (مگابایت)
MKT_MAX_UPLOAD_MB=100
# مبدأهای مجاز CORS (با کاما جدا کنید)
MKT_CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------- زمان‌بند و پیامک
# زمان‌بند داخلی (اسکن روزانه‌ی اعلان‌های چرخه‌ی خرید) — 0 برای خاموش
MKT_SCHEDULER_ENABLE=1
# ساعت اجرای روزانه (به‌وقت تهران)
MKT_SCHEDULE_HOUR=8
# ارسال خودکار پیامک یادآوری توسط زمان‌بند (فقط با پنل پیکربندی‌شده) — پیش‌فرض خاموش
MKT_AUTO_SMS=0
# فعال‌سازی ارسال واقعی پیامک (بدون آن همه‌چیز dry-run امن می‌ماند)
# توکنِ دسترسی. قاعده: **هر مسیرِ نوشتنی (POST/PUT/PATCH/DELETE) بسته است**،
# مگر آنکه در `OPEN_WRITE_ROUTES` در `src/mktcore/security.py` با دلیل استثنا
# شده باشد (بارگذاری فایل، داده‌ی نمونه، تحلیل محلی، برچسبِ نشست، و بازخوانی
# کمپین). چند مسیرِ **خواندنی** هم بسته‌اند چون شماره‌ی تماسِ کامل می‌دهند:
# `GET /api/export`، `GET /api/outbox` و `GET /api/v1/campaigns/{id}/export`.
# خالی = بدون گارد؛ در این حالت هر کسی که به آدرس دسترسی داشته باشد می‌تواند
# پیامک واقعی بفرستد. **فقط حروف و ارقام انگلیسی** — مقدارِ هدر HTTP باید ASCII باشد.
# بعد از تنظیم، همین مقدار را در رابط کاربری (نشانِ «توکن لازم است» در نوار
# بالای صفحه) وارد کنید، وگرنه خودِ برنامه هم ۴۰۱ می‌گیرد.
# MKT_API_TOKEN=

# هزینه‌ی هر قطعه پیامک به ریال (۳۰۰ تومان = ۳۰۰۰)
# MKT_SMS_COST_PER_SEGMENT_RIAL=3000

MKT_SMS_ENABLE=0
MKT_SMS_PROVIDER=kavenegar
# KAVENEGAR_API_KEY=...
# MKT_SMS_SENDER=...
