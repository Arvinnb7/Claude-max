# کلید API انتروپیک — برای لایه‌ی استراتژی هوش مصنوعی لازم است
ANTHROPIC_API_KEY=sk-ant-...

# مدل مورد استفاده برای روایت و استراتژی مارکتر سنیور (پیش‌فرض)
MKT_MODEL=claude-opus-4-8

# مدل ارزان‌تر برای پیش‌نویس سریع (اختیاری)
MKT_DRAFT_MODEL=claude-haiku-4-5

# سطح تلاش استدلال: low | medium | high | max
MKT_EFFORT=high

# واحد پول برای نمایش گزارش‌ها
MKT_CURRENCY=تومان

# اجرای تست‌های واقعی هوش مصنوعی (فقط محلی) — 1 برای فعال‌سازی
MKT_LIVE_AI=0

# ---------------------------------------------------------- پایداری و سرور
# پوشه‌ی داده‌های ماندگار (SQLite نشست‌ها/jobها/outbox + فایل‌های نشست)
MKT_DATA_DIR=data
# عمر نشست‌ها به ساعت (بعد از آن پاک می‌شوند)
MKT_SESSION_TTL_HOURS=72
# سقف حجم فایل آپلودی (مگابایت)
MKT_MAX_UPLOAD_MB=100
# مبدأهای مجاز CORS (با کاما جدا کنید)
MKT_CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------- زمان‌بند و پیامک
# زمان‌بند داخلی (اسکن روزانه‌ی اعلان‌های چرخه‌ی خرید) — 0 برای خاموش
MKT_SCHEDULER_ENABLE=1
# ساعت اجرای روزانه (به‌وقت تهران)
MKT_SCHEDULE_HOUR=8
# ارسال خودکار پیامک یادآوری توسط زمان‌بند (فقط با پنل پیکربندی‌شده) — پیش‌فرض خاموش
MKT_AUTO_SMS=0
# فعال‌سازی ارسال واقعی پیامک (بدون آن همه‌چیز dry-run امن می‌ماند)
MKT_SMS_ENABLE=0
MKT_SMS_PROVIDER=kavenegar
# KAVENEGAR_API_KEY=...
# MKT_SMS_SENDER=...
